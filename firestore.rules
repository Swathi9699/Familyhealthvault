rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      let household = get(/databases/$(database)/documents/households/$(householdId));
      return isAuthenticated() && (
        household.data.ownerId == request.auth.uid ||
        request.auth.uid in household.data.memberUids
      );
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Household vaults
    match /households/{householdId} {
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );

      // Sub-collections in the household vault
      match /members/{memberId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /medications/{medicationId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /appointments/{appointmentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /documents/{documentId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /visitSummaries/{summaryId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }
  }
}
