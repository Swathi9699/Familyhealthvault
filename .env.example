# ==============================================================================
# Family Health Vault AI — Environment Variables
# ==============================================================================

# Server Runtime Port (Google Cloud Run automatically sets PORT=8080)
PORT=8080
NODE_ENV=production

# ==============================================================================
# SECRETS (SERVER-SIDE ONLY — NEVER EXPOSE TO FRONTEND BUNDLE)
# ==============================================================================
# Optional: Google Gemini API Key for server-side AI Clinical Briefing proxy.
# When deployed to Cloud Run, inject this securely using Google Secret Manager:
# gcloud run services update family-health-vault --set-secrets=GEMINI_API_KEY=gemini-api-key:latest
#
# If omitted, the server automatically uses the built-in synthetic clinical
# reasoning engine so the demo operates with zero external billing or API keys.
GEMINI_API_KEY="your-server-side-gemini-api-key"

# Private Demo Access Key (Optional secondary layer for private investor/clinical reviews)
PRIVATE_DEMO_PASSPHRASE="vault-demo-2026"
